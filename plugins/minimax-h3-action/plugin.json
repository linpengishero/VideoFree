{
  "schema_version": 1,
  "id": "minimax-h3-action",
  "version": "1.0.0",
  "name": "连戏 · MiniMax-H3",
  "name_key": "连戏 · MiniMax-H3",
  "description": "导演协作驱动的分段续写视频：时长为整片总时长，超过 15 秒自动分为 2–5 段续写，画面与声音自动拼接为一条完整视频。",
  "description_key": "导演协作驱动的分段续写视频：时长为整片总时长，超过 15 秒自动分为 2–5 段续写，画面与声音自动拼接为一条完整视频。",
  "collaboration_ui": { "entry": "ui/dist/collaboration.js" },
  "categories": [
    {
      "id": "video",
      "name": "视频生成",
      "icon": "solar:clapperboard-play-linear",
      "name_key": "视频生成"
    }
  ],
  "modes": [
    {
      "id": "direct",
      "name": "直接生成",
      "name_key": "直接生成"
    },
    {
      "id": "director",
      "handler": "collaboration/handler.py:director",
      "name": "导演协作",
      "name_key": "导演协作"
    }
  ],
  "capabilities": {
    "video.two_segment_reference": {
      "kind": "video",
      "mode": "reference",
      "category": "video",
      "name": "全能参考",
      "name_key": "全能参考",
      "model_id": "minimax-h3-action",
      "model_name": "MiniMax H3 长片",
      "model_name_key": "MiniMax H3 长片",
      "model_family": "minimax-h3-action",
      "file": "workflows/video/two_segment_reference.json",
      "compiler": "builtin",
      "compiler_handler": "compiler.py:prepare",
      "confirmation_handler": "collaboration/confirmation.py:prepare",
      "processing_modes": ["director"],
      "output_prefix": "MediaGateway/video",
      "prompt": {
        "preserve_all": true
      },
      "prompt_bindings": [
        {
          "node": "136",
          "input": "prompt"
        }
      ],
      "media_bindings": {
        "image": [
          { "node": "136", "input": "ref_images.ref_image_0", "connect": true, "source_index": 0 },
          { "node": "136", "input": "ref_images.ref_image_1", "connect": true, "source_index": 1 },
          { "node": "136", "input": "ref_images.ref_image_2", "connect": true, "source_index": 2 },
          { "node": "136", "input": "ref_images.ref_image_3", "connect": true, "source_index": 3 },
          { "node": "136", "input": "ref_images.ref_image_4", "connect": true, "source_index": 4 },
          { "node": "136", "input": "ref_images.ref_image_5", "connect": true, "source_index": 5 },
          { "node": "224", "input": "ref_images.ref_image_0", "connect": true, "source_index": 0 },
          { "node": "224", "input": "ref_images.ref_image_1", "connect": true, "source_index": 1 },
          { "node": "224", "input": "ref_images.ref_image_2", "connect": true, "source_index": 2 },
          { "node": "224", "input": "ref_images.ref_image_3", "connect": true, "source_index": 3 },
          { "node": "224", "input": "ref_images.ref_image_4", "connect": true, "source_index": 4 },
          { "node": "224", "input": "ref_images.ref_image_5", "connect": true, "source_index": 5 }
        ],
        "video": [
          { "node": "136", "input": "ref_videos.ref_video_0", "connect": true, "source_index": 0 },
          { "node": "224", "input": "ref_videos.ref_video_0", "connect": true, "source_index": 0 }
        ],
        "audio": [
          { "node": "136", "input": "ref_audios.ref_audio_0", "connect": true, "source_index": 0 },
          { "node": "224", "input": "ref_audios.ref_audio_0", "connect": true, "source_index": 0 }
        ]
      },
      "parameter_bindings": {
        "seed": [
          { "node": "129", "input": "noise_seed" },
          { "node": "225", "input": "noise_seed" }
        ],
        "width": [
          { "node": "900", "input": "value" }
        ],
        "height": [
          { "node": "901", "input": "value" }
        ],
        "duration": [
          { "node": "132", "input": "value" }
        ]
      },
      "output_nodes": ["237"],
      "output_bindings": [
        { "node": "236", "input": "filename_prefix" }
      ],
      "prune_to_outputs": true,
      "dimension_alignment": 32,
      "duration": {
        "min": 1,
        "max": 75,
        "default": 10
      },
      "references": {
        "image": { "min": 1, "max": 6 },
        "video": { "min": 0, "max": 1 },
        "audio": { "min": 0, "max": 1 }
      },
      "parameters": {
        "director_plan": {
          "type": "string",
          "required": false,
          "maxLength": 40,
          "label": "导演确认标记",
          "label_key": "导演确认标记"
        },
        "segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 1,
          "label": "续写段数",
          "label_key": "续写段数"
        },
        "durations": {
          "type": "string",
          "required": false,
          "default": "",
          "maxLength": 200,
          "label": "各段时长（秒，逗号分隔）",
          "label_key": "各段时长（秒，逗号分隔）"
        },
        "prompt_2": {
          "type": "string",
          "required": false,
          "maxLength": 20000,
          "label": "第二段描述词",
          "label_key": "第二段描述词"
        },
        "prompt_3": {
          "type": "string",
          "required": false,
          "maxLength": 20000,
          "label": "第三段描述词",
          "label_key": "第三段描述词"
        },
        "prompt_4": {
          "type": "string",
          "required": false,
          "maxLength": 20000,
          "label": "第四段描述词",
          "label_key": "第四段描述词"
        },
        "prompt_5": {
          "type": "string",
          "required": false,
          "maxLength": 20000,
          "label": "第五段描述词",
          "label_key": "第五段描述词"
        }
      },
      "requirements": {
        "nodes": [
          "UNETLoader",
          "CLIPLoader",
          "VAELoader",
          "LoraLoaderModelOnly",
          "EasyCache",
          "ModelAttentionBackend",
          "BlockSparseAttention",
          "MiniMaxH3SigmaShift",
          "MiniMaxH3ReferenceToVideo",
          "MiniMaxH3AddGuide",
          "BasicGuider",
          "BasicScheduler",
          "ManualSigmas",
          "RandomNoise",
          "KSamplerSelect",
          "SamplerCustomAdvanced",
          "ComfyMathExpression",
          "PrimitiveFloat",
          "PrimitiveInt",
          "VAEDecode",
          "VAEDecodeAudio",
          "GetImageRangeFromBatch",
          "ImageBatchMulti",
          "AudioConcat",
          "SaveAudioAdvanced",
          "LoadImage",
          "LoadAudio",
          "VHS_LoadVideo",
          "VHS_VideoCombine"
        ],
        "models": [
          "models/diffusion_models/minimax/Cobijada_H3_Hybrid_Uncensored_pruned_hybrid_int8_convrot_pruned.safetensors",
          "models/text_encoders/qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
          "models/vae/minimax_h3_video_vae_fp16.safetensors",
          "models/vae/minimax_h3_audio_vae_fp32.safetensors",
          "models/loras/MINIMAX/minimax_h3_ref2v_turbo_8step_v1.0_768p_comfyui_bf16.safetensors",
          "models/loras/MINIMAX/H3_speed_slider_1.1.safetensors",
          "models/loras/MINIMAX/Motion_Repair_V2.safetensors",
          "models/loras/MINIMAX/H3_Combat_V2.safetensors"
        ]
      },
      "ui": {
        "version": 1,
        "fields": [
          {
            "bind": "prompt",
            "component": "textarea",
            "label": "剧情描述",
            "label_key": "剧情描述",
            "section": "body",
            "rows": 3,
            "required": true,
            "placeholder": "描述画面、动作、运镜与对白，导演按时长自动分段续写",
            "placeholder_key": "描述画面、动作、运镜与对白，导演按时长自动分段续写"
          },
          {
            "bind": "settings.reference_image",
            "component": "media",
            "media": "image",
            "label": "参考图片",
            "label_key": "参考图片",
            "section": "body"
          },
          {
            "bind": "settings.reference_video",
            "component": "media",
            "media": "video",
            "label": "参考视频",
            "label_key": "参考视频",
            "section": "body"
          },
          {
            "bind": "settings.reference_audio",
            "component": "media",
            "media": "audio",
            "label": "参考声音",
            "label_key": "参考声音",
            "section": "body"
          },
          {
            "bind": "settings.ratio",
            "label": "比例",
            "label_key": "比例",
            "section": "settings",
            "component": "select",
            "default": "16:9",
            "options": [
              { "value": "16:9", "label": "16:9 横屏", "label_key": "16:9 横屏" },
              { "value": "9:16", "label": "9:16 竖屏", "label_key": "9:16 竖屏" },
              { "value": "1:1", "label": "1:1 方形", "label_key": "1:1 方形" },
              { "value": "4:3", "label": "4:3 标准", "label_key": "4:3 标准" },
              { "value": "3:4", "label": "3:4 竖版", "label_key": "3:4 竖版" },
              { "value": "21:9", "label": "21:9 超宽", "label_key": "21:9 超宽" },
              { "value": "2:3", "label": "2:3 海报", "label_key": "2:3 海报" },
              { "value": "3:2", "label": "3:2 相机", "label_key": "3:2 相机" }
            ]
          },
          {
            "bind": "settings.resolution",
            "label": "分辨率",
            "label_key": "分辨率",
            "section": "settings",
            "component": "select",
            "default": "480P",
            "options": [
              { "value": "480P", "label": "480P" },
              { "value": "576P", "label": "576P" },
              { "value": "720P", "label": "720P" },
              { "value": "768P", "label": "768P" }
            ]
          },
          {
            "bind": "settings.duration",
            "label": "整片时长（秒）",
            "label_key": "整片时长（秒）",
            "section": "submit",
            "component": "number",
            "minimum": 1,
            "maximum": 75,
            "step": 1,
            "default": 10,
            "required": true
          }
        ]
      }
    }
  },
  "localization": {
    "default_locale": "zh-CN",
    "messages": {
      "zh-CN": "locales/zh-CN.json",
      "en-US": "locales/en-US.json"
    }
  },
  "ui_models": [
    {
      "id": "minimax-h3-action",
