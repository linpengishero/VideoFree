              },
              {
                "value": "1:1",
                "label": "1:1 方形"
              },
              {
                "value": "4:3",
                "label": "4:3 标准"
              },
              {
                "value": "3:4",
                "label": "3:4 竖版"
              },
              {
                "value": "21:9",
                "label": "21:9 超宽"
              },
              {
                "value": "2:3",
                "label": "2:3 海报"
              },
              {
                "value": "3:2",
                "label": "3:2 相机"
              }
            ],
            "component": "select",
            "default": "16:9"
          },
          {
            "bind": "settings.resolution",
            "label": "分辨率",
            "section": "settings",
            "options": [
              {
                "value": "768P",
                "label": "自适应"
              },
              {
                "value": "1K",
                "label": "1K"
              },
              {
                "value": "1440P",
                "label": "1440P"
              },
              {
                "value": "2K",
                "label": "2K"
              }
            ],
            "component": "select",
            "default": "1K"
          },
          {
            "bind": "settings.style_id",
            "label": "画面风格",
            "section": "settings",
            "component": "style",
            "default": ""
          }
        ]
      },
      "name": "Qwen 四宫格分镜",
      "model_id": "qwen",
      "model_name": "Qwen Image 2.1"
