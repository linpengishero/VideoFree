      "task_instruction": "默认生成写实电影质感的完整2x2四宫格电影分镜图，共且仅共4格，固定为2列2行，严格按左上、右上、左下、右下阅读顺序推进用户故事。参考图仅用于保持人物身份、服装、道具、场景和视觉风格一致；没有参考图时根据文字创建。每格完整填满自己的等大单元格，只呈现画面，禁止任何额外小格、嵌套分格、缩略图、替代视图、联系表、镜号、标题、字幕、气泡、UI、箭头、Logo、水印、外框和粗分隔线。画面保持真实材质、自然光影、清晰边缘、连贯透视和高分辨率细节。",
      "category": "image",
      "compiler": "builtin",
      "confirmation_handler": "collaboration/confirmation.py:confirm",
      "model_family": "qwen",
      "processing_modes": [
        "direct",
        "director"
      ],
      "compiler_handler": "compiler.py:prepare",
      "ui": {
        "version": 1,
        "fields": [
          {
            "bind": "prompt",
            "component": "textarea",
            "label": "描述词",
            "section": "body",
            "rows": 3,
            "required": true
          },
          {
            "bind": "settings.reference_image",
            "component": "media",
            "media": "image",
            "label": "参考图片",
            "section": "body"
          },
          {
            "bind": "settings.ratio",
            "label": "比例",
            "section": "settings",
            "options": [
              {
                "value": "16:9",
                "label": "16:9 横屏"
              },
              {
                "value": "9:16",
