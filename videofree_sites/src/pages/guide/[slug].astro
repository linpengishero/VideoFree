---
import { getCollection } from 'astro:content';
import DocsPage from '../../components/DocsPage.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs', (d) => d.id.startsWith('zh/'));
  return docs.map((doc) => ({ params: { slug: doc.id.split('/')[1] }, props: { doc, lang: 'zh' } }));
}

const { doc, lang } = Astro.props;
---

<DocsPage {doc} {lang} />
