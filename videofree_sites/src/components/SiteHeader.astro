---
import { t, path, switchPath } from '../lib/i18n';

const { lang, current = 'home', guideSlug } = Astro.props;
const s = t(lang);
const en = lang === 'en';

const links = [
  { key: 'home', page: 'home' },
  { key: 'plugins', page: 'plugins' },
  { key: 'canvas', page: 'canvas' },
  { key: 'guide', page: 'guide', slug: guideSlug ?? 'install' },
  { key: 'download', page: 'download' },
  { key: 'license', page: 'license' },
];
const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={path(lang, 'home')}>
      <img src="/logo.png" alt="" width="30" height="30" />
      <strong>VideoFree Studio</strong>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-label={en ? 'Toggle navigation' : '展开导航'}
    >
      <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12"/><path d="M18 6 6 18"/></svg>
    </button>
    <nav class="main-nav" aria-label={en ? 'Main navigation' : '主导航'}>
      {links.map((l) => {
        const href = path(lang, l.page, l.slug);
        const active = current === l.page || (l.page === 'guide' && current === 'guide');
        return <a href={href} aria-current={active ? 'page' : undefined}>{s.nav[l.key]}</a>;
      })}
      <a class="hide-sm" href={en ? 'https://github.com/linpengishero/VideoFreeStudio' : 'https://gitee.com/heroofgod_admin/videofreestudio'} target="_blank" rel="noopener noreferrer">{s.github}</a>
      <span class="lang-switch" role="group" aria-label="Language">
        <a href={switchPath(here, 'zh')} lang="zh" aria-current={lang === 'zh' ? 'page' : undefined}>中文</a>
        <a href={switchPath(here, 'en')} lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </span>
    </nav>
  </div>
</header>
