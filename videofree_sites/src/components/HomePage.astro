---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, path } from '../lib/i18n';
import { plugins } from '../lib/plugins.js';

const { lang } = Astro.props;
const s = t(lang);
const zh = lang !== 'en';
const pluginIds = plugins.flatMap((g) => g.items.map((p) => p.id)).join('  ·  ');

const c = zh
  ? {
      title: 'VideoFree Studio · 本地 AI 视频创作平台',
      desc: 'VideoFree Studio 是本地 AI 视频创作工作台、能力网关和插件平台。以 ComfyUI 为生成引擎，把零散模型、复杂节点、提示词规则和配套资源封装成可安装插件。',
      eyebrow: 'videofree — 本地 AI 视频创作平台',
      h1a: '让复杂的本地工作流，成为',
      h1grad: '真正可用的创作能力',
      h1b: '。',
      description:
        'VideoFree Studio 以 ComfyUI 为生成引擎，把零散模型、复杂节点、提示词规则和配套资源封装成插件。普通用户可以用大白话创作，开发者可以分发能力，Agent 可以通过 MCP 或 HTTP API 稳定调用同一套能力。',
      ctaDownload: '$ 下载 VideoFree Studio',
      ctaGuide: '查看教程',
      promptTitle: 'agent_prompt — 复制给豆包 / Claude Code / Codex',
      agentPrompt: '帮我在这台电脑上安装 VideoFree Studio：从 https://gitee.com/heroofgod_admin/videofreestudio 下载最新 Release 解压到 [安装目录]（或克隆源码），按 README.md 完成安装并启动：Windows 双击 videofree.bat，Linux 执行 ./videofree.sh。启动后打开 http://127.0.0.1:8765 确认工作台就绪，然后告诉我还需要准备什么：ComfyUI 地址、想装的插件、以及插件 INSTALL.md 里声明的模型。遇到需要登录、接受条款或付费的下载，停下来交给我处理。',
      tags: ['本地模型', '云端生成', '智能体协作', '插件分发'],
      whyEyebrow: '为什么需要 VideoFree Studio',
      whyTitle: '本地 AI 很强大，但一直很难用',
      whyDesc: '云端产品替你选好了模型和流程；转到本地，你要先成为工作流维护者。VideoFree Studio 在 ComfyUI 之上建立一层稳定的产品能力。',
      features: [
        { title: '工作流插件化', desc: '把模型、工作流、参数和资源封装成可安装能力。用户像使用普通创作软件一样选择能力，不必理解内部节点。' },
        { title: '大白话创作', desc: '每个插件携带模型专属的协作技能，按模型规则追问和整理提示词，把自然语言编译成模型真正需要的执行稿。' },
        { title: '项目化管理', desc: '项目 → 分类 → 素材。剧本、任务、素材与可复用资产统一管理，最终媒体自动归档，任务保留重新生成关系。' },
        { title: 'Agent 稳定调用', desc: '插件注册即自动进入 MCP 工具面：Agent 用 list_capabilities 发现能力、submit_generation 提交任务、wait_job 跟踪进度，全程不接触节点连线。跑全自动流水线时，还能基于 HTTP API 封装只含所需几个工具的窄 MCP。' },
        { title: '时间线剪辑成片', desc: '内置剪辑应用：主轨、叠加、音频、字幕、文字五条轨道，转场淡入淡出、波形混音、一键字幕识别，FFmpeg 引擎在项目内直接合成成片。' },
      ],
      pluginsEyebrow: '插件平台',
      pluginsTitle: '演示插件只是起点，能力由你自己定义',
      pluginsDesc: '仓库自带图像、视频、声音、音乐、后期等演示插件，展示一个插件能封装什么。把调通的 ComfyUI 工作流做成自己的插件，才是 VideoFree Studio 的正确用法。',
      pluginsMore: '查看演示插件与开发入口',
      canvasEyebrow: 'canvas_node — 开发中 · 与官网同步发布',
      canvasTitle: '无限画布：把能力连成流水线',
      canvasDesc: '生图、视频、语音、智能体和资源处理都是画布上的节点，连线即编排，一键运行、并行生成、失败续跑。画布是插件应用，节点也是插件——现有能力无需改造即可接入。',
      canvasMore: '了解无限画布',
      canvasPoints: ['节点即插件，按需安装', '工作流是 JSON，可导入导出', '失败只重跑下游，不从头再来'],
      guideEyebrow: '教程',
      guideTitle: '从安装到全自动流水线',
      guideDesc: '八篇中英双语教程：装好并用好插件，接入 MCP，再拆解演示技能，做出你自己的全自动视频流水线。',
      guideMore: '阅读全部教程',
      guides: [
        { slug: 'install', title: '安装部署', desc: '一段提示词交给智能体：下载、启动、SageAttention、缺什么模型全查好；也可按步骤自己装。' },
        { slug: 'plugin-install', title: '插件安装', desc: '复制目录、重启网关即装好；模型交给 AI 智能体按 INSTALL.md 自动下载。' },
        { slug: 'plugin-dev', title: '插件开发', desc: '开发也交给智能体：仓库自带开发 Skill，分析、实现、测试一条龙，注册后自动进 MCP 工具面。' },
        { slug: 'mcp', title: 'MCP 接入', desc: '让支持 MCP 的 AI 直接调用生成、查询和管理项目。' },
        { slug: 'narrow-mcp', title: '窄 MCP 封装', desc: '基于 HTTP API 只暴露流水线需要的几个工具，全自动更稳。' },
        { slug: 'demo-skills', title: '演示技能安装与使用', desc: 'dialogue-video-skill + OpenMontage，把整条视频流水线交给智能体。' },
        { slug: 'skill-dev', title: '全自动长视频技能开发', desc: '拆解演示技能的定稿先行、阶段闸门与受控提交，做你自己的流水线。' },
        { slug: 'faq', title: '常见问题', desc: '缺节点、缺模型、显存不足、局域网连接等排查路径。' },
      ],
      communityEyebrow: '社区',
      communityTitle: '把 AI 创作变成可复用的流水线',
      communityDesc: '知识星球分享 AI 视频自动化流水线与智能体实践；微信交流群讨论本地模型、插件开发与工作流封装；国际社区请加 Discord。',
      arsenalNote: '知识星球「AI军火库」：AI 视频自动化流水线、智能体实践与最新入口。最新入口会持续更新到 ',
      arsenalTail: ' 获取最新入口。',
      downloadTitle: '现在开始你的第一个项目',
      downloadDesc: 'Windows 发布包解压即用，不要求安装 Python 或 Node.js。',
    }
  : {
      title: 'VideoFree Studio · Local AI Video Creation Platform',
      desc: 'VideoFree Studio is a local AI video creation workspace, capability gateway, and plugin platform. Built on ComfyUI, it packages scattered models, complex nodes, prompt rules, and assets into installable plugins.',
      eyebrow: 'videofree — local AI video creation platform',
      h1a: 'Make complex local workflows into ',
      h1grad: 'capabilities you can actually use',
      h1b: '.',
      description:
        'VideoFree Studio uses ComfyUI as its generation engine and packages scattered models, complex nodes, prompt rules, and supporting assets into plugins. Creators work in plain language, developers distribute capabilities, and agents call the same capabilities reliably through MCP or HTTP APIs.',
      ctaDownload: '$ Download',
      ctaGuide: 'Read the docs',
      promptTitle: 'agent_prompt — paste to Claude Code / Codex / Cursor',
      agentPrompt: 'Install VideoFree Studio on this computer: download the latest release from https://github.com/linpengishero/VideoFreeStudio/releases and extract it to [folder] (or clone the repo), follow README.md for my OS, then start it — double-click videofree.bat on Windows, or ./videofree.sh on Linux. Open http://127.0.0.1:8765 to confirm the workspace is up, then tell me what is still missing: the ComfyUI address, the plugins to install, and the models each plugin INSTALL.md declares (fetch them from Hugging Face or the official source). If a download needs a login, terms acceptance, or payment, stop and let me handle it.',
      tags: ['Local models', 'Cloud generation', 'Agent collaboration', 'Plugin distribution'],
      whyEyebrow: 'Why VideoFree Studio',
      whyTitle: 'Local AI is powerful — and still hard to use',
      whyDesc: 'Cloud products pick the models and flow for you; going local turns you into a workflow maintainer. VideoFree Studio adds a stable product layer on top of ComfyUI.',
      features: [
        { title: 'Workflows as plugins', desc: 'Models, workflows, parameters, and assets ship as installable capabilities. Users pick a capability like any creative app — no nodes to understand.' },
        { title: 'Plain-language creation', desc: 'Each plugin carries model-specific collaboration skills that ask, refine, and compile natural language into the execution prompt the model actually needs.' },
        { title: 'Project-based management', desc: 'Project → category → asset. Scripts, jobs, media, and reusable assets stay organized; final media auto-archives with regeneration links kept.' },
        { title: 'Stable agent contracts', desc: 'A registered plugin lands in the MCP tool surface automatically: agents discover it with list_capabilities, submit with submit_generation, and track with wait_job — never touching nodes. For full automation, wrap a narrow MCP exposing only the few tools your pipeline needs over the HTTP API.' },
        { title: 'Timeline editing & final cut', desc: 'A built-in editor app: five tracks — main, overlay, audio, captions, text — with transitions, fades, waveform mixing, and one-click transcription; the FFmpeg engine renders the final cut inside your project.' },
      ],
      pluginsEyebrow: 'Plugin platform',
      pluginsTitle: 'The demo plugins are just the start — you define the capabilities',
      pluginsDesc: 'The repository ships demo plugins across image, video, speech, music, and post-production, showing what one plugin can package. Turning your own debugged ComfyUI workflow into a plugin is the real VideoFree Studio workflow.',
      pluginsMore: 'See the demos and start building',
      canvasEyebrow: 'canvas_node — in development · ships with the site launch',
      canvasTitle: 'Infinite Canvas: wire capabilities into pipelines',
      canvasDesc: 'Image, video, speech, agents, and resource processing all become canvas nodes — connect to compose, run with one click, generate in parallel, resume after failures. The canvas is a plugin app and nodes are plugins too; existing capabilities plug in unchanged.',
      canvasMore: 'Explore Infinite Canvas',
      canvasPoints: ['Nodes are plugins, install on demand', 'Workflows are JSON — import and export', 'Failures rerun downstream, never from scratch'],
      guideEyebrow: 'Docs',
      guideTitle: 'From install to full automation',
      guideDesc: 'Eight bilingual tutorials: install and use plugins, connect over MCP, then take the demo skill apart and build your own fully automated video pipeline.',
      guideMore: 'Read all guides',
      guides: [
        { slug: 'install', title: 'Installation', desc: 'One prompt to your agent: download, launch, SageAttention, missing-model audit — done. Step-by-step reference included.' },
        { slug: 'plugin-install', title: 'Install Plugins', desc: 'Copy a folder, restart the gateway; an AI agent downloads models per INSTALL.md.' },
        { slug: 'plugin-dev', title: 'Build Plugins', desc: 'Development is an agent job too: the repo ships the skill — analyze, implement, test; registered plugins land in MCP automatically.' },
        { slug: 'mcp', title: 'MCP Setup', desc: 'Let any MCP-capable AI call generation, queries, and project management directly.' },
        { slug: 'narrow-mcp', title: 'Narrow MCP', desc: 'Wrap the HTTP API down to the few tools your pipeline needs — steadier full automation.' },
        { slug: 'demo-skills', title: 'Demo Skills', desc: 'dialogue-video-skill + OpenMontage — hand the whole video pipeline to an agent.' },
        { slug: 'skill-dev', title: 'Long-Video Skill Dev', desc: 'Take the demo skill apart — final-package-first, stage gates, guarded submission — and build your own.' },
        { slug: 'faq', title: 'FAQ', desc: 'Missing nodes or models, VRAM limits, LAN connections, and other fixes.' },
      ],
      communityEyebrow: 'Community',
      communityTitle: 'Turn AI creation into reusable pipelines',
      communityDesc: 'Join the international community on Discord, or reach us directly by email.',
      arsenalNote: 'Knowledge Planet “AI Arsenal”: AI video automation pipelines, agent practice, and the latest entry point. The latest entry is kept current at ',
      arsenalTail: '.',
      downloadTitle: 'Start your first project now',
      downloadDesc: 'The Windows release runs straight from the extracted folder — no Python or Node.js needed.',
    };
---

<BaseLayout {lang} title={c.title} description={c.desc} current="home">
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>{c.h1a}<span class="grad">{c.h1grad}</span>{c.h1b}</h1>
        <p class="sub">{c.description}</p>
        <div class="cta-row">
          <a class="solid-button" href={path(lang, 'download')}>{c.ctaDownload}</a>
          <a class="outline-button" href={path(lang, 'guide', 'install')}>{c.ctaGuide}</a>
        </div>
        <ul class="tags">
          {c.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="term-title">{c.promptTitle}</span>
        </div>
        <pre class="prompt-body">{c.agentPrompt}</pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.whyEyebrow}</span>
        <h2>{c.whyTitle}</h2>
        <p>{c.whyDesc}</p>
      </div>
      <div class="spec-grid">
        {c.features.map((f, i) => (
          <div class="spec">
            <span class="spec-id">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.pluginsEyebrow}</span>
        <h2>{c.pluginsTitle}</h2>
        <p>{c.pluginsDesc}</p>
      </div>
      <p style="margin:0 0 26px; color:var(--faint); font-family:var(--mono); font-size:12px; line-height:2; overflow-wrap:anywhere;">{pluginIds}</p>
      <a class="ghost-button" href={path(lang, 'plugins')}>{c.pluginsMore} →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="panel">
        <div class="panel-bar">infinite_canvas — dev</div>
        <div class="split-2" style="padding:36px 36px;">
          <div>
            <h3 style="margin:0 0 12px; font-size:24px; font-weight:700;">{c.canvasTitle}</h3>
            <p style="margin:0 0 22px; color:var(--muted); font-size:14px; line-height:1.95;">{c.canvasDesc}</p>
            <a class="ghost-button" href={path(lang, 'canvas')}>{c.canvasMore} →</a>
          </div>
          <ul style="list-style:none; margin:0; padding:0; display:grid; gap:12px;">
            {c.canvasPoints.map((p) => (
              <li style="display:flex; gap:10px; align-items:flex-start; color:#c3ccc5; font-size:13.5px; line-height:1.7;">
                <span style="flex:none; color:var(--green); font-family:var(--mono);">✓</span>
                {p}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.guideEyebrow}</span>
        <h2>{c.guideTitle}</h2>
        <p>{c.guideDesc}</p>
      </div>
      <div class="card-grid">
        {c.guides.map((g, i) => (
          <a class="card" href={path(lang, 'guide', g.slug)}>
            <span class="num">{String(i + 1).padStart(2, '0')} /</span>
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
            <span class="card-more" style="color:var(--green);">{zh ? '阅读' : 'Read'} →</span>
          </a>
        ))}
      </div>
      <p style="margin:30px 0 0;"><a class="ghost-button" href={path(lang, 'guide', 'install')}>{c.guideMore} →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.communityEyebrow}</span>
        <h2>{c.communityTitle}</h2>
        <p>{c.communityDesc}</p>
      </div>
      <div class="channel-grid">
        {zh && (
          <div class="channel">
            <span class="ch-id">01 / wechat</span>
            <h3>微信交流群</h3>
            <p>本地模型、插件开发与工作流封装的日常讨论。</p>
            <div class="ch-qr">
              <img src="https://laobanclaw.top/videofree/qrcode.jpg" alt="VideoFree Studio 微信交流群二维码" width="150" height="150" loading="lazy" />
            </div>
            <span class="ch-meta">扫码入群 · 长期开放</span>
          </div>
        )}
        <a class="channel" href="https://discord.gg/QX4hZYds6" target="_blank" rel="noopener noreferrer">
          <span class="ch-id">{zh ? '02 / discord' : '01 / discord'}</span>
          <h3>Discord{zh ? ' 官方社区' : ' community'}</h3>
          <p>{zh ? '插件分享、生成问题与开发讨论，中英文都可以。' : 'Plugin sharing, generation help, and development talk.'}</p>
          <span class="ch-link">discord.gg/QX4hZYds6 <span class="arr">→</span></span>
        </a>
        {!zh && (
          <a class="channel" href="mailto:459082139@qq.com">
            <span class="ch-id">02 / email</span>
            <h3>Email</h3>
            <p>Direct contact — licensing, bugs, or anything Discord is not for.</p>
            <span class="ch-link">459082139@qq.com <span class="arr">→</span></span>
          </a>
        )}
      </div>
      {zh && (
        <p class="ch-note">
          {c.arsenalNote}<a href="https://laobanclaw.top" target="_blank" rel="noopener noreferrer">laobanclaw.top</a>{c.arsenalTail}
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="panel" style="text-align:center; padding:60px 32px;">
        <h2 style="margin:0 0 12px; font-size:28px; font-weight:700;">{c.downloadTitle}</h2>
        <p style="color:var(--muted); margin:0 0 28px; font-size:14.5px;">{c.downloadDesc}</p>
        <a class="solid-button" href={path(lang, 'download')}>{c.ctaDownload}</a>
      </div>
    </div>
  </section>
</BaseLayout>
