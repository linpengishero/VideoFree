---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, path } from '../lib/i18n';
import { plugins } from '../lib/plugins.js';

const { lang } = Astro.props;
const zh = lang !== 'en';
const kindLabel = { local: zh ? '本地' : 'Local', cloud: zh ? '云端' : 'Cloud', tool: zh ? '工具' : 'Tool' };

const c = zh
  ? {
      title: '插件 · VideoFree Studio',
      desc: 'VideoFree Studio 自带演示插件，展示插件平台能承载的能力形态。把调通的 ComfyUI 工作流封装成你自己的插件，才是正确用法。',
      eyebrow: 'Demo plugins',
      h1: '演示插件',
      lead: '仓库自带的这些插件只是演示，用来展示一个插件能封装什么：生图、视频、语音、音乐、后期、项目工具。VideoFree Studio 的本质是插件平台——真正该装的，是你把自己的 ComfyUI 工作流做成的插件。',
      devTitle: '做你自己的插件',
      devDesc: '一个 plugin.json 就是唯一注册入口：工作流、参数界面、协作技能、固定资源都放进一个目录，复制进 plugins/ 重启网关即生效。工作台用户和外部 Agent 自动共享同一套能力。',
      devCta: '插件开发教程',
      protocol: '插件协议',
      skill: '开发 Skill',
      modelsNote: '需要模型时不用手动找：每个插件的 INSTALL.md 声明所需模型，交给 AI 智能体自动下载，见',
      modelsLink: '插件安装教程',
    }
  : {
      title: 'Plugins · VideoFree Studio',
      desc: 'VideoFree Studio ships demo plugins showing what the plugin platform can carry. The real use is packaging your own debugged ComfyUI workflows as plugins.',
      eyebrow: 'Demo plugins',
      h1: 'Demo plugins',
      lead: 'The plugins bundled in the repository are demos — they show what one plugin can package: image, video, speech, music, post-production, project tools. VideoFree Studio is fundamentally a plugin platform: what you should really install is the plugin you build from your own debugged ComfyUI workflow.',
      devTitle: 'Build your own plugin',
      devDesc: 'One plugin.json is the only registration entry: workflow, parameter UI, collaboration skills, and fixed assets live in one folder. Copy it into plugins/, restart the gateway, done. Workspace users and external agents share the same capability automatically.',
      devCta: 'Plugin development guide',
      protocol: 'Plugin protocol',
      skill: 'Dev skill',
      modelsNote: 'No manual model hunting: each plugin declares required models in INSTALL.md — let an AI agent download them. See the',
      modelsLink: 'Plugin Installation guide',
    };
---

<BaseLayout {lang} title={c.title} description={c.desc} current="plugins">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.eyebrow}</span>
        <h2 style="margin-top:16px;">{c.h1}</h2>
        <p>{c.lead}</p>
      </div>

      {plugins.map((g) => (
        <div class="plugin-group">
          <h3>{g.group[zh ? 'zh' : 'en']}</h3>
          {g.items.map((p) => (
            <div class="plugin-row">
              <span class="pname">{p.name[zh ? 'zh' : 'en']}</span>
              <span class="pdesc">{p.desc[zh ? 'zh' : 'en'].split(zh ? '：' : ': ')[0]}</span>
              <span class={`kind ${p.kind}`}>{kindLabel[p.kind]}</span>
            </div>
          ))}
        </div>
      ))}

      <p style="color:var(--faint); font-size:12.5px;">
        {c.modelsNote} <a href={path(lang, 'guide', 'plugin-install')}>{c.modelsLink}</a>{zh ? '。' : ''}
      </p>

      <div class="panel" style="margin-top:48px;">
        <div class="panel-bar">plugin.json — your workflow, shipped</div>
        <div style="padding:30px 28px;">
          <h3 style="margin:0 0 10px; font-size:19px;">{c.devTitle}</h3>
          <p style="margin:0 0 22px; color:var(--muted); font-size:14px; line-height:1.9;">{c.devDesc}</p>
          <p style="margin:0; display:flex; flex-wrap:wrap; gap:12px;">
            <a class="solid-button" href={path(lang, 'guide', 'plugin-dev')}>{c.devCta}</a>
            <a class="outline-button" href={zh ? 'https://gitee.com/heroofgod_admin/videofreestudio/blob/master/docs/plugin-protocol.md' : 'https://github.com/linpengishero/VideoFreeStudio/blob/main/docs/plugin-protocol.md'} target="_blank" rel="noopener noreferrer">{c.protocol}</a>
            <a class="outline-button" href={zh ? 'https://gitee.com/heroofgod_admin/videofreestudio/tree/master/.agents/skills/videofree-plugin-development' : 'https://github.com/linpengishero/VideoFreeStudio/tree/main/.agents/skills/videofree-plugin-development'} target="_blank" rel="noopener noreferrer">{c.skill}</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
