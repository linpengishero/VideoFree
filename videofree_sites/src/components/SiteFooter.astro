---
import { t, path } from '../lib/i18n';

const { lang } = Astro.props;
const s = t(lang);
const zh = lang !== 'en';

const cols = zh
  ? [
      {
        title: '产品',
        items: [
          { label: '插件平台', href: path(lang, 'plugins') },
          { label: '无限画布', href: path(lang, 'canvas') },
          { label: '下载', href: path(lang, 'download') },
        ],
      },
      {
        title: '资源',
        items: [
          { label: '教程文档', href: path(lang, 'guide', 'install') },
          { label: 'Gitee（码云）', href: 'https://gitee.com/heroofgod_admin/videofreestudio', ext: true },
          { label: 'GitHub', href: 'https://github.com/linpengishero/VideoFreeStudio', ext: true },
        ],
      },
      {
        title: '联系与授权',
        items: [
          { label: '459082139@qq.com', href: 'mailto:459082139@qq.com' },
          { label: 'Discord 社区', href: 'https://discord.gg/QX4hZYds6', ext: true },
          { label: '许可证（AGPL-3.0）', href: path(lang, 'license') },
          { label: '商业授权', href: path(lang, 'license') + '#commercial' },
          { label: 'AI军火库', href: 'https://laobanclaw.top/', ext: true },
        ],
      },
    ]
  : [
      {
        title: 'Product',
        items: [
          { label: 'Plugin platform', href: path(lang, 'plugins') },
          { label: 'Infinite Canvas', href: path(lang, 'canvas') },
          { label: 'Download', href: path(lang, 'download') },
        ],
      },
      {
        title: 'Resources',
        items: [
          { label: 'Docs', href: path(lang, 'guide', 'install') },
          { label: 'GitHub', href: 'https://github.com/linpengishero/VideoFreeStudio', ext: true },
        ],
      },
      {
        title: 'Contact & License',
        items: [
          { label: '459082139@qq.com', href: 'mailto:459082139@qq.com' },
          { label: 'Discord community', href: 'https://discord.gg/QX4hZYds6', ext: true },
          { label: 'License (AGPL-3.0)', href: path(lang, 'license') },
          { label: 'Commercial license', href: path(lang, 'license') + '#commercial' },
        ],
      },
    ];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={path(lang, 'home')}>
          <img src="/logo.png" alt="" width="30" height="30" />
          <strong>VideoFree Studio</strong>
        </a>
        <p>{s.footer.slogan}</p>
        <p class="fine">{s.footer.license}</p>
      </div>
      {cols.map((col) => (
        <div class="footer-col">
          <h4>{col.title}</h4>
          <ul>
            {col.items.map((it) => (
              <li>
                {it.ext
                  ? <a href={it.href} target="_blank" rel="noopener noreferrer">{it.label}</a>
                  : <a href={it.href}>{it.label}</a>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>{s.footer.copyright}</span>
      <span>{zh ? '以 ComfyUI 为生成引擎 · 插件平台' : 'Generation engine: ComfyUI · Plugin platform'}</span>
    </div>
  </div>
</footer>
