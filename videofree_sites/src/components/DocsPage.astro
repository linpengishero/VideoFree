---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, path, guideOrder } from '../lib/i18n';

const { doc, lang } = Astro.props;
const s = t(lang);
const slug = doc.id.split('/')[1];
const { Content } = await render(doc);
const idx = guideOrder.indexOf(slug);
const prev = idx > 0 ? guideOrder[idx - 1] : null;
const next = idx >= 0 && idx < guideOrder.length - 1 ? guideOrder[idx + 1] : null;
---

<BaseLayout {lang} title={`${doc.data.title} · VideoFree Studio`} description={doc.data.lead} current="guide" guideSlug={slug}>
  <div class="wrap docs-layout">
    <nav class="docs-nav" aria-label={s.guideNavTitle}>
      <span class="group">{s.guideNavTitle}</span>
      {guideOrder.map((item) => (
        <a href={path(lang, 'guide', item)} aria-current={item === slug ? 'page' : undefined}>
          {s.guideNav[item]}
        </a>
      ))}
    </nav>
    <article class="docs-body">
      <h1>{doc.data.title}</h1>
      <p class="lead">{doc.data.lead}</p>
      <Content />
      <div class="docs-footer-nav">
        <span>{prev && <a href={path(lang, 'guide', prev)}><span class="dir">← {s.prev}</span><span>{s.guideNav[prev]}</span></a>}</span>
        <span>{next && <a href={path(lang, 'guide', next)}><span class="dir">{s.next} →</span><span>{s.guideNav[next]}</span></a>}</span>
      </div>
    </article>
  </div>
</BaseLayout>
