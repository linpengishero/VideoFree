---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { t } from '../lib/i18n';

const { lang = 'zh', title, description, current = 'home', guideSlug, ogType = 'website' } = Astro.props;
const s = t(lang);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternates = {
  zh: new URL(Astro.url.pathname.replace(/^\/en/, '') || '/', Astro.site).href,
  en: new URL(lang === 'en' ? Astro.url.pathname : '/en' + (Astro.url.pathname === '/' ? '/' : Astro.url.pathname), Astro.site).href,
};
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={alternates.zh} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.zh} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/logo.png', Astro.site).href} />
    <meta property="og:site_name" content="VideoFree Studio" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0c0f0d" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <SiteHeader {lang} {current} {guideSlug} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter {lang} />
    <!-- External file (not inlined) so the strict script-src 'self' CSP keeps working. -->
    <script type="module" src="/site.js"></script>
  </body>
</html>
