"COMBO","widget":{"name":"precision"},"link":null},{"localized_name":"attention","name":"attention","type":"COMBO","widget":{"name":"attention"},"link":null},{"localized_name":"local_model_path","name":"local_model_path","shape":7,"type":"STRING","widget":{"name":"local_model_path"},"link":null}],"outputs":[{"localized_name":"model","name":"model","type":"QWEN3_MODEL","links":[3]}],"properties":{"aux_id":"DarioFT/ComfyUI-Qwen3-TTS","Node name for S&R":"Qwen3Loader","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"cnr_id":"comfyui-qwen3-tts","ver":"17c22adb80a63c1c51bf74549e71a5cf218f4e1b"},"widgets_values":["Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice","HuggingFace","bf16","auto",""]},{"id":7,"type":"Qwen3VoiceDesign","pos":[1174.3342104417547,2103.6222387801195],"size":[491.56876383375584,450.54316643609945],"flags":{},"order":3,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"QWEN3_MODEL","link":5},{"localized_name":"text","name":"text","type":"STRING","widget":{"name":"text"},"link":null},{"localized_name":"instruct","name":"instruct","type":"STRING","widget":{"name":"instruct"},"link":null},{"localized_name":"language","name":"language","type":"COMBO","widget":{"name":"language"},"link":null},{"localized_name":"seed","name":"seed","type":"INT","widget":{"name":"seed"},"link":null}],"outputs":[{"localized_name":"音频","name":"AUDIO","type":"AUDIO","links":[6]}],"properties":{"Node name for S&R":"Qwen3VoiceDesign","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"cnr_id":"comfyui-qwen3-tts","ver":"17c22adb80a63c1c51bf74549e71a5cf218f4e1b"},"widgets_values":["这是菌林虫凝胶果，可以食用!","**ORION-7｜qwn-tts 声音设定描述词**\n\n机械男声少年音，年龄感约12到15岁，普通话标准，声线清脆偏高，但带轻微电子合成感。音色像小型机器人助手，不厚重，不成熟，不低沉，有少年感和一点可爱感，但不是幼儿音，也不是撒娇音。\n\n声音干净、清亮、偏薄，句尾偶尔有轻微电流断续感。发声里带一点破碎金属质感，像老旧机体扬声器有细小杂音、轻微失真和短暂卡顿，但整体仍然清楚可听。每句话开头可以有轻微系统启动感，关键词前有短暂停顿，像正在扫描和计算。\n\n语速中等偏快，反应灵敏，提示信息清楚。危险提醒时语气会突然变短、变急，但不会大喊。日常对话时带一点天真的认真感，像很努力在保护主角的小机器人。\n\n语气基调：清脆、机械、少年感、认真、可靠、微可爱、轻微破损感。它不是冰冷 AI，也不是成熟管家，而是一个旧型号但很忠诚的小型机器人助手。\n\n**一句话版本：**  \n清脆偏高的机械少年音，带轻微电子合成感和破碎金属杂音，语气认真、灵敏、微可爱，像旧型号小机器人助手。\n\n**关键词：**  \n机械少年音、12到15岁少年感、清脆、偏高、干净、偏薄、电子合成感、轻微金属质感、破碎扬声器感、轻微电流噪点、短暂卡顿、扫描停顿、认真、可靠、微可爱、小型机器人助手、普通话标准。\n\n**禁忌：**  \n不要厚重男声，不要成熟大叔音，不要低沉反派音，不要新闻播报腔，不要客服腔，不要导航音，不要幼儿音，不要夹子音，不要撒娇卖萌，不要过度机械到听不清，不要大喊。","Auto",50330919728942,"fixed",[false,true],[false,true]]}],"links":[[1,4,0,1,0,"AUDIO"],[2,4,0,2,0,"AUDIO"],[3,3,0,4,0,"QWEN3_MODEL"],[4,6,0,4,1,"AUDIO"],[5,5,0,7,0,"QWEN3_MODEL"],[6,7,0,8,0,"AUDIO"]],"groups":[{"id":1,"title":"Qwen3 TTS声音设计","bounding":[803.3271323382409,2035.8745077005967,1228.2006094384728,538.8175088678609],"color":"#3f789e","flags":{}},{"id":2,"title":"Qwen3 TTS声音克隆","bounding":[815.4260219017201,2641.799370866968,1178.2883320996566,457.5160419084177],"color":"#3f789e","flags":{}}],"config":{},"extra":{"ue_links":[],"ds":{"scale":1.1918176537728324,"offset":[-394.0860201397178,-1913.7306460990408]},"frontendVersion":"1.45.20","VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true},"version":0.4}