COMFYUI_URL=http://127.0.0.1:8189
MEDIA_GATEWAY_HOST=0.0.0.0
MEDIA_GATEWAY_PORT=8765
# 可在网页设置中填写，例如 D:\ComfyUI\output
COMFYUI_OUTPUT_DIR=./data/comfyui_output
# 留空则不启用 API token；跨机器局域网使用时建议设置
MEDIA_GATEWAY_TOKEN=
MEDIA_GATEWAY_DATA=./data
MEDIA_CONCURRENCY=1
MAX_QUEUE_SIZE=20
MAX_TEXT_LENGTH=20000
# 智能协作等待本地模型的秒数；0 表示不限制等待时间
AGENT_TIMEOUT_SECONDS=0
# Example: {"documentary_female":{"command":"python tts.py --text \"{text}\" --voice {voice} --output \"{output}\""}}
VOICE_PRESETS_JSON={}
